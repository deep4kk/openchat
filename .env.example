# Public URL of this app (must be HTTPS for Meta; use ngrok/cloudflared in dev)
APP_URL=https://your-tunnel.ngrok-free.app

# Local: SQLite file (nothing to install). Hosted: the PostgreSQL URL from Render, e.g.
# DATABASE_URL="postgresql://user:pass@host.render.com/autodm?sslmode=require&connection_limit=3"
DATABASE_URL="file:./dev.db"

# From Meta App Dashboard > Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Your Instagram username (without @). Only the accounts listed here can log in to this copy;
# anyone else is turned away before anything is saved. Several: ALLOWED_IG_USERNAMES=me,mybrand
ALLOWED_IG_USERNAMES=

# Any random string; must match "Verify token" in the webhook settings
WEBHOOK_VERIFY_TOKEN=

# 32+ random chars each:  openssl rand -hex 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

GRAPH_API_VERSION=v23.0

# ---- Optional: sending limits per Instagram account (safe defaults) ----
# Meta allows 750 comment->DM private replies/hour; we stay far below it.
# MAX_DMS_PER_HOUR=200
# MAX_PUBLIC_REPLIES_PER_HOUR=100
# MIN_SEND_GAP_MS=2000

# ---- Shown on the Privacy, Terms and Data deletion pages ----
# Required before Meta App Review: reviewers check that these pages name who runs the app.
# APP_NAME=AutoDM
# CONTACT_EMAIL=you@example.com
# OPERATOR_NAME=Your name or company
# SOURCE_CODE_URL=https://github.com/you/autodm

# ---- Hosting ----
# Set automatically on Vercel. Set to 1 on any other host where the website must not
# send messages itself because a separate "npm run worker" process does it.
# DISABLE_INLINE_WORKER=1

# Turn off anonymous usage telemetry of the Next.js and Prisma CLIs
NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1
